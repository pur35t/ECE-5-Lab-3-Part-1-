clear; clc; close all;

[t1,y1] = genSine(0.5, 4, 5, 10);
[t2,y2] = genSine(2,   4, 5, 10);
[t3,y3] = genSine(2,   4, 5, 6);

figure;
subplot(3,1,1); plot(t1,y1,'-o'); title('0.5 Hz, Amplitude 4, 10 samples/period'); xlabel('Time (s)'); ylabel('Amplitude'); grid on;
subplot(3,1,2); plot(t2,y2,'-o'); title('2 Hz, Amplitude 4, 10 samples/period');   xlabel('Time (s)'); ylabel('Amplitude'); grid on;
subplot(3,1,3); plot(t3,y3,'-o'); title('2 Hz, Amplitude 4, 6 samples/period');    xlabel('Time (s)'); ylabel('Amplitude'); grid on;

function [t, y] = genSine(freq, amp, time, samplesPerPeriod)
fs = freq * samplesPerPeriod;
t  = 0:1/fs:time;
y  = amp * sin(2*pi*freq*t);
end
