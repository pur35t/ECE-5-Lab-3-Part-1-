clear all; close all; clc;

%% Part 1: 500 Hz sine wave
f = 500;
a = 1;
fs = 20*f;
dt = 1/fs;
t = 0:dt:0.02;
y = a * sin(2*pi*f*t);

figure(1);
plot(t, y, 'b', 'LineWidth', 1.5);
xlabel('Time (s)');
ylabel('Amplitude');
title('500 Hz Sine Wave');
grid on;

%% Part 2: same 500 Hz sine, different sampling frequencies
t1 = 0:1/(2*f):0.02;
t2 = 0:1/(5*f):0.02;
t3 = 0:1/(9*f):0.02;

y1 = a * sin(2*pi*f*t1);
y2 = a * sin(2*pi*f*t2);
y3 = a * sin(2*pi*f*t3);

figure(2);

subplot(3, 1, 1);
plot(t1, y1, 'g', 'LineWidth', 2);
title('fs = 2f');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

subplot(3, 1, 2);
plot(t2, y2, 'g', 'LineWidth', 2);
title('fs = 5f');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

subplot(3, 1, 3);
plot(t3, y3, 'g', 'LineWidth', 2);
title('fs = 9f');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

sgtitle('500 Hz Sine Wave at Different Sampling Frequencies');
